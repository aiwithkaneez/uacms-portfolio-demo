DATABASE_URL=postgresql+psycopg://uacms_user:change_me@localhost:5432/uacms
SECRET_KEY=replace-with-a-long-random-secret-of-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-with-a-generated-fernet-key-see-comment-above

# Optional. If SMTP_HOST is set, complainants receive their Complaint ID by email
# after submission. Leave unset for local demo — the ID is still shown on screen.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=uacms@example.com
# SMTP_PASSWORD=replace-me
# SMTP_FROM=UACMS <uacms@example.com>
# SMTP_USE_TLS=true
# FRONTEND_URL=http://localhost:5174
