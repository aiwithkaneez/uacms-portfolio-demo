# Template for production environment variables — set these in your hosting
# platform's dashboard (Render/Railway), not in a committed file.

# Supabase: Project Settings -> Database -> Connection string (URI), then
# swap the scheme to postgresql+psycopg for the psycopg3 driver this app uses.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@YOUR_PROJECT.supabase.co:5432/postgres

# Generate a fresh one for production — do not reuse the local dev value.
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-freshly-generated-64-char-hex-secret

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# The real deployed frontend URL(s), comma-separated. No trailing slash.
ALLOWED_ORIGINS=https://your-app.vercel.app

# Generate a fresh one for production — do not reuse the local dev value,
# and do not lose it once real Whistleblow/Harassment data exists under it.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-with-a-freshly-generated-fernet-key

# Optional SMTP for complaint-ID confirmation emails after submission.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=uacms@example.com
# SMTP_PASSWORD=replace-me
# SMTP_FROM=UACMS <noreply@example.com>
# SMTP_USE_TLS=true
# FRONTEND_URL=https://your-app.vercel.app

# Render/Railway inject PORT automatically — no need to set it yourself.
